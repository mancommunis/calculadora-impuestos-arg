# Copiar a .env y completar. NUNCA commitear .env.
# Las keys de proveedores de IA viven idealmente en el keychain del SO.
# Este archivo es para CI / desarrollo local.

# Proveedor de IA (BYOK)
DEEPSEEK_API_KEY=sk-xxxx

# Turso / libSQL (DB compartida / billetera)
TURSO_DATABASE_URL=libsql://xxxx.turso.io
TURSO_AUTH_TOKEN=xxxx
